<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/nilelearn/db" VERSION="20260723" COMMENT="XMLDB file for local_nilelearn"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_nilelearn_command" COMMENT="Provider-side idempotency and command result evidence">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="commanduuid" TYPE="char" LENGTH="36" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="idempotencykey" TYPE="char" LENGTH="128" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="payloadhash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="operation" TYPE="char" LENGTH="80" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="actoruserid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="targetexternalid" TYPE="char" LENGTH="80" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="processing" SEQUENCE="false"/>
        <FIELD NAME="providerversion" TYPE="char" LENGTH="80" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="resultjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="actoruserid_fk" TYPE="foreign" FIELDS="actoruserid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="contextid_fk" TYPE="foreign" FIELDS="contextid" REFTABLE="context" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="commanduuid_uix" UNIQUE="true" FIELDS="commanduuid"/>
        <INDEX NAME="idempotencykey_uix" UNIQUE="true" FIELDS="idempotencykey"/>
        <INDEX NAME="actor_time_ix" UNIQUE="false" FIELDS="actoruserid,timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
